# ============================================================
# APPLICATION
# ============================================================

APP_NAME=Supply-Chain Disruption Agent API
APP_ENVIRONMENT=development
DEBUG=false
MOCK_MODE=false


# ============================================================
# BACKEND
# ============================================================

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000


# ============================================================
# FRONTEND
# ============================================================

FRONTEND_URL=http://localhost:3000


# ============================================================
# SHIPMENT TOOL
# ============================================================

SHIPMENT_DATA_PATH=data/processed/shipment_tool_data.csv


# ============================================================
# MACHINE LEARNING
# ============================================================

MODEL_PATH=models/xgb_model.joblib
PREPROCESSOR_PATH=models/preprocessor.joblib

# Provisional value. Replace after validation threshold selection.
RISK_THRESHOLD=0.40
HIGH_RISK_THRESHOLD=0.70


# ============================================================
# RAG
# ============================================================

VECTOR_STORE_PATH=rag/vector_store
RAG_COLLECTION_NAME=operational_sops


# ============================================================
# AZURE OPENAI
# ============================================================

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01

# Deployment used to generate the disruption briefing
AZURE_OPENAI_CHAT_DEPLOYMENT=

# Deployment used by Chroma ingestion and retrieval
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ============================================================
# WEATHER TOOL
# ============================================================

# Open-Meteo historical archive and geocoding. No API key is required.
WEATHER_API_BASE_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_TIMEOUT_SECONDS=10
# Not used by Open-Meteo.
WEATHER_API_KEY=


# ============================================================
# SUPPLIER AND INVENTORY TOOLS
# ============================================================

SUPPLIER_DATA_PATH=data/processed/supplier_tool_data.csv
INVENTORY_DATA_PATH=data/processed/inventory_tool_data.csv
MODEL_DATA_PATH=data/processed/df_model.zip